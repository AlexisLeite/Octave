{
  "name": "octave-notebook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": ".\\.upm\\bin\\cm.cmd run --id octave-notebook-dev --cwd . -- pnpm dev:raw",
    "dev:raw": "concurrently -k -n api,ui -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:ui\"",
    "dev:api": "tsx watch scripts/dev-api.mjs",
    "dev:ui": "vite",
    "serve": "pnpm build && pnpm serve:dist",
    "serve:dist": "tsx scripts/serve.mjs",
    "build": "tsc -b && vite build",
    "package": "pnpm build && node scripts/package.mjs",
    "test:package": "node scripts/test-package.mjs",
    "start": "tsx server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@monaco-editor/react": "^4.7.0",
    "express": "^5.1.0",
    "katex": "^0.18.2",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.19.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.1",
    "prosemirror-model": "^1.24.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.38.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/svg-to-pdfkit": "^0.1.4",
    "@vitejs/plugin-react": "^4.5.0",
    "commander": "^15.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
